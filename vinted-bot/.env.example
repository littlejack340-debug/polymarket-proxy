# Token du bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# ID du serveur Discord (clic droit sur le serveur > Copier l'ID, en mode developpeur)
GUILD_ID=123456789012345678

# Salon par defaut ou les alertes seront postees
DEFAULT_CHANNEL_ID=123456789012345678

# Role a ping pour les bons deals (optionnel)
RESELLERS_ROLE_ID=

# Intervalle de polling Vinted en secondes (min recommande : 30)
POLL_INTERVAL=60

# Delai minimum entre 2 requetes HTTP Vinted (en secondes)
REQUEST_DELAY=4
